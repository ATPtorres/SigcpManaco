# Copiar a .env y establecer contraseñas propias. Nunca versionar .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigcp_manaco
DB_USER=sigcp
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_USER=admin
APP_PASSWORD=1234
HOST=127.0.0.1
PORT=3000
# Para despliegue HTTPS detrás de un proxy fiable: COOKIE_SECURE=true
COOKIE_SECURE=false
# Para un servidor MySQL remoto con TLS: DB_SSL_CA=/ruta/ca.pem

# Origen público exacto al usar HTTPS detrás de un proxy (sin barra final):
# APP_ORIGIN=https://produccion.example.com
# Base exclusiva para pruebas destructivas; debe terminar en _test:
DB_TEST_NAME=sigcp_manaco_test
